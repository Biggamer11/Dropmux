#!/bin/sh
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export APPDIR
# Loader-scoped search path: never inject bundled libc into host tmux/shells.
unset LD_LIBRARY_PATH LD_PRELOAD PYTHONHOME PYTHONPATH
export PYTHONHOME="$APPDIR/usr"
export PYTHONNOUSERSITE=1
exec "$APPDIR/usr/lib/ld-linux-x86-64.so.2" --library-path "$APPDIR/usr/lib" "$APPDIR/usr/bin/python3" -s "$APPDIR/usr/share/dropmux/entry.py" "$@"
